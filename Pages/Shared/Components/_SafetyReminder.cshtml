@inject FraudVerificationDemo.Services.SafetyContentService SafetyContent

@*
    Safety Reminder Component
    Displays the highest-level reminder on all emergency pages.
    Static content: does NOT depend on AI, database, or Credits.
    Status: DRAFT content from CONTENT-LIBRARY.md (awaiting user approval)
*@

<div class="safety-reminder" role="note">
    <span class="safety-reminder-icon" aria-hidden="true"><i class="bi bi-sign-stop"></i></span>
    <div>
        <div class="safety-reminder-head">
            <h2>Stop and read this first</h2>
            <span class="badge badge-draft">Draft content</span>
        </div>
        <p class="pre-line">@SafetyContent.GetHighestLevelReminder()</p>
    </div>
</div>
