@inject Microsoft.AspNetCore.Identity.SignInManager<FraudVerificationDemo.Models.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<FraudVerificationDemo.Models.ApplicationUser> UserManager
@inject FraudVerificationDemo.Services.SafetyContentService SafetyContent

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "Get practical guidance to identify possible scams, verify suspicious payment or information requests, and take action after fraud.")" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f7faf8" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Scam and Fraud Support") | Safeline" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Get practical guidance to identify possible scams, verify suspicious payment or information requests, and take action after fraud.")" />
    <title>@(ViewData["Title"] ?? "Scam and Fraud Support") | Safeline</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="demo-banner" role="note"><div class="container demo-banner-inner"><span class="demo-pill">DEMO</span><span>This is a local demonstration. Do not enter real personal information.</span></div></div>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true">S</span><span>Safe<span class="brand-light">line</span><small>Fraud support, made clearer</small></span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="navbarNav"><ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Help/Select">Get help</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="baselineDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">My protection</a><ul class="dropdown-menu dropdown-menu-end" aria-labelledby="baselineDropdown"><li><a class="dropdown-item" asp-page="/Baseline/Index">Overview</a></li><li><a class="dropdown-item" asp-page="/Baseline/Rules">Protection rules</a></li><li><a class="dropdown-item" asp-page="/Baseline/Contacts">Trusted contacts</a></li><li><a class="dropdown-item" asp-page="/Baseline/Payments">Usual payments</a></li></ul></li>
                        <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity?.Name</a><ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown"><li><a class="dropdown-item" asp-page="/Account/Manage/DeletePersonalData">Account settings</a></li><li><hr class="dropdown-divider" /></li><li><form method="post" asp-page="/Account/Logout"><button type="submit" class="dropdown-item">Log out</button></form></li></ul></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Log in</a></li>
                        <li class="nav-item ms-lg-2"><a class="btn btn-primary nav-cta" asp-page="/Account/Register">Create account</a></li>
                    }
                </ul></div>
            </div>
        </nav>
    </header>
    <main role="main" class="site-main"><div class="container">@RenderBody()</div></main>
    <footer class="site-footer"><div class="container footer-inner"><div><a class="footer-brand" asp-page="/Index">Safeline</a><p>Practical support for safer decisions.</p><a class="footer-privacy" asp-page="/Privacy">Privacy notice</a></div><div class="footer-note"><p>@SafetyContent.GetDisclaimer()</p><span>© 2026 Safeline Demo · For internal review only</span></div></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
