@page
@model IndexModel
@{
    ViewData["Title"] = "Scam and Fraud Help";
    ViewData["Description"] = "Worried about a scam? Learn how to verify suspicious payment and personal information requests, take action if you already paid, and make a plan to protect yourself.";
}

<section class="home-hero">
    <div class="hero-copy">
        <span class="eyebrow"><span class="status-dot"></span> A calm next step starts here</span>
        <h1>Pause. Verify.<br /><span>Stay in control.</span></h1>
        <p class="hero-lede">Not sure if a request is real? Take a breath. We’ll help you decide what to do next—without pressure or judgement.</p>
        <div class="hero-note"><span class="note-icon" aria-hidden="true">i</span><span>You don’t need to decide or send anything right now.</span></div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="shield-card"><div class="shield-icon">✓</div><span>YOUR SAFETY</span><strong>Comes first</strong><div class="shield-rule"></div><small>Take your time. Check it out.</small></div><div class="art-spark spark-one">✦</div><div class="art-spark spark-two">✳</div></div>
</section>

<section class="urgent-section" aria-labelledby="urgent-title">
    <div class="section-heading"><div><span class="eyebrow">HOW CAN WE HELP?</span><h2 id="urgent-title">Choose what’s happening</h2></div><span class="section-step">01 <i></i> 03</span></div>
    <div class="emergency-buttons">
        <a asp-page="/Help/Select" class="urgent-card urgent-payment"><span class="urgent-icon" aria-hidden="true">$</span><span class="urgent-copy"><strong>Someone is asking me to pay</strong><small>Check a payment request before you send money</small></span><span class="urgent-arrow" aria-hidden="true">↗</span></a>
        <a asp-page="/Help/Select" class="urgent-card urgent-info"><span class="urgent-icon" aria-hidden="true">•••</span><span class="urgent-copy"><strong>Someone wants my information</strong><small>Get help protecting your details and accounts</small></span><span class="urgent-arrow" aria-hidden="true">↗</span></a>
        <a asp-page="/Help/AfterIncident" class="urgent-card urgent-after"><span class="urgent-icon" aria-hidden="true">!</span><span class="urgent-copy"><strong>I already paid or shared something</strong><small>See what you can do now. It’s not too late to act.</small></span><span class="urgent-arrow" aria-hidden="true">↗</span></a>
    </div>
</section>

<section class="prepare-section">
    <div class="prepare-icon" aria-hidden="true">✳</div>
    <div class="prepare-copy"><span class="eyebrow">A LITTLE PREPARATION HELPS</span><h2>Make a plan before you need one</h2><p>Save your trusted people and usual payment habits, so it’s easier to spot something unusual later.</p></div>
    <div class="prepare-action">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-page="/Baseline/Index" class="btn btn-primary">Open my protection plan <span aria-hidden="true">→</span></a>
        }
        else
        {
            <a asp-page="/Account/Register" class="btn btn-primary">Create your free plan <span aria-hidden="true">→</span></a>
            <a asp-page="/Account/Login" class="prepare-login">Already have an account? Log in</a>
        }
    </div>
</section>

<section class="features-section" aria-label="What you can prepare">
    <div class="feature-item"><span class="feature-icon feature-shield" aria-hidden="true">✓</span><div><h3>Personal rules</h3><p>Set boundaries while you have time to think.</p></div></div>
    <div class="feature-item"><span class="feature-icon feature-people" aria-hidden="true">↗</span><div><h3>Trusted people</h3><p>Know who to call when something feels off.</p></div></div>
    <div class="feature-item"><span class="feature-icon feature-wallet" aria-hidden="true">$</span><div><h3>Usual payments</h3><p>Remember how you normally pay bills.</p></div></div>
</section>
