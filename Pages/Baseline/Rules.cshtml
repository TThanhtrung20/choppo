@page
@model FraudVerificationDemo.Pages.Baseline.RulesModel
@{
    ViewData["Title"] = "Personal Scam Protection Rules";
    ViewData["Description"] = "Create and manage personal scam prevention rules to help you pause, verify unusual payment requests, and protect your accounts from fraud.";
    var examples = new[]
    {
        "I will never pay taxes or fines using gift cards",
        "I will never share my banking password or PIN with anyone",
        "I will not pay upfront to receive a prize or lottery winnings",
        "My bank will never ask me to move money to a \"safe account\"",
        "I will verify any urgent payment request by calling back on the official number",
        "I will not click links in unexpected emails claiming to be from my bank"
    };
}

<div class="manage-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Index">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <a asp-page="./Index">My protection</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">Protection rules</span>
    </nav>

    <header class="manage-heading">
        <div class="manage-heading-main">
            <span class="manage-icon tone-teal" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
            <div>
                <span class="eyebrow">Your personal protection plan</span>
                <h1>Protection rules</h1>
                <p>Write down clear boundaries to help you pause when a request feels unusual.</p>
            </div>
        </div>
        <a asp-page="./Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to overview</a>
    </header>

    @* Everything inside this panel is swapped by HTMX after add / edit / delete. *@
    <div id="rules-panel" class="manage-layout" hx-target="#rules-panel" hx-select="#rules-panel" hx-swap="outerHTML">
        <div class="manage-main">
            <partial name="Shared/Components/_StatusMessage" model="Model.StatusMessage" />

            <section class="form-card @(Model.IsEditing ? "is-editing" : "")" data-scroll-target aria-labelledby="rule-form-title">
                <div class="form-card-header">
                    <h2 id="rule-form-title">
                        <i class="bi @(Model.IsEditing ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></i>
                        @(Model.IsEditing ? "Edit rule" : "Add a new rule")
                    </h2>
                    @if (Model.IsEditing)
                    {
                        <span class="badge text-bg-warning">Editing</span>
                    }
                </div>
                <form method="post" asp-page="./Rules">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-end">
                            <label asp-for="Input.Content" class="form-label">Your protection rule</label>
                            <small id="rule-counter" class="char-counter" aria-live="polite"></small>
                        </div>
                        <textarea asp-for="Input.Content" class="form-control" rows="3" minlength="10" maxlength="500" required data-counter="#rule-counter"
                                  aria-describedby="rule-help"
                                  placeholder="Example: I will never pay using gift cards for any bill or tax payment"
                                  data-autofocus="@(Model.IsEditing ? "true" : null)"></textarea>
                        <span asp-validation-for="Input.Content" class="invalid-feedback d-block"></span>
                        <div id="rule-help" class="form-text">Write a clear statement about what you will or won’t do. At least 10 characters.</div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <span class="spinner-border spinner-border-sm btn-spinner" aria-hidden="true"></span>
                            <i class="bi @(Model.IsEditing ? "bi-check2" : "bi-plus-lg")" aria-hidden="true"></i>
                            @(Model.IsEditing ? "Save changes" : "Add rule")
                        </button>
                        @if (Model.IsEditing)
                        {
                            <a asp-page="./Rules" class="btn btn-light">Cancel</a>
                        }
                    </div>
                </form>
            </section>

            <section class="item-section" aria-labelledby="rules-list-title">
                <div class="item-section-header">
                    <h2 id="rules-list-title">Your rules</h2>
                    <span class="count-pill">@Model.Rules.Count</span>
                </div>

                @if (Model.Rules.Any())
                {
                    <ul class="rule-list">
                        @foreach (var rule in Model.Rules)
                        {
                            <li class="rule-item @(Model.Input?.Id == rule.Id ? "is-selected" : "")">
                                <span class="rule-mark" aria-hidden="true"><i class="bi bi-check2"></i></span>
                                <div class="rule-body">
                                    <p>@rule.Content</p>
                                    <small>
                                        <i class="bi bi-calendar3" aria-hidden="true"></i> Created @rule.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                        @if (rule.UpdatedAt.HasValue)
                                        {
                                            <span class="dot-sep">·</span><text>Updated @rule.UpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</text>
                                        }
                                    </small>
                                </div>
                                <div class="item-actions">
                                    <a asp-page="./Rules" asp-route-edit="@rule.Id" class="btn btn-icon" title="Edit rule" aria-label="Edit rule">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form method="post" asp-page="./Rules" asp-page-handler="Delete" asp-route-id="@rule.Id"
                                          data-confirm="Delete this rule?" hx-confirm="Delete this rule? This cannot be undone.">
                                        <button type="submit" class="btn btn-icon btn-icon-danger" title="Delete rule" aria-label="Delete rule">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon" aria-hidden="true"><i class="bi bi-shield-plus"></i></span>
                        <h3>No rules yet</h3>
                        <p>Add your first protection rule above, or start from one of the examples.</p>
                    </div>
                }
            </section>
        </div>

        <aside class="manage-aside" aria-label="About protection rules">
            <div class="info-card">
                <h2><i class="bi bi-info-circle" aria-hidden="true"></i> What are protection rules?</h2>
                <p>Personal safety principles you write while calm, before any pressure or urgency. They help you pause and verify unusual requests.</p>
            </div>
            <div class="info-card">
                <h2><i class="bi bi-lightbulb" aria-hidden="true"></i> Example rules</h2>
                <ul class="tip-list">
                    @foreach (var example in examples)
                    {
                        <li>@example</li>
                    }
                </ul>
            </div>
        </aside>
    </div>
</div>
