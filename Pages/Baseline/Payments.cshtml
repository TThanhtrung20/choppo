@page
@model FraudVerificationDemo.Pages.Baseline.PaymentsModel
@{
    ViewData["Title"] = "Usual Payment Methods";
}

<partial name="Shared/Components/_DemoWarning" />

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>💳 Usual Payment Methods</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <div class="alert alert-warning">
        <h5 class="alert-heading">⚠️ Page Under Construction</h5>
        <p class="mb-0">
            This page will allow you to manage usual payment methods (how you normally pay bills).
            It will be implemented in Day 9 of the development plan.
        </p>
    </div>

    <div class="mt-4">
        <h4>Coming Soon:</h4>
        <ul>
            <li>Add payment methods (bank name, payment type, description)</li>
            <li>Edit and delete payment methods</li>
            <li>View list of all usual payment methods</li>
        </ul>
    </div>
</div>
