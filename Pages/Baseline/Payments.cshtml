@page
@model FraudVerificationDemo.Pages.Baseline.PaymentsModel
@using FraudVerificationDemo.Models
@{
    ViewData["Title"] = "Usual Payment Methods and Scam Prevention";
    ViewData["Description"] = "Record your normal ways of paying bills and sending money so unusual payment requests are easier to recognize and verify.";
    var methods = Enum.GetValues<PaymentMethodType>();
}

<div class="manage-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Index">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <a asp-page="./Index">My protection</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">Usual payments</span>
    </nav>

    <header class="manage-heading">
        <div class="manage-heading-main">
            <span class="manage-icon tone-amber" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
            <div>
                <span class="eyebrow">Your personal protection plan</span>
                <h1>Usual payment methods</h1>
                <p>Keep a reminder of how you normally pay bills and send money.</p>
            </div>
        </div>
        <a asp-page="./Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to overview</a>
    </header>

    <div id="payments-panel" class="manage-layout" hx-target="#payments-panel" hx-select="#payments-panel" hx-swap="outerHTML">
        <div class="manage-main">
            <partial name="Shared/Components/_StatusMessage" model="Model.StatusMessage" />

            <section class="form-card @(Model.IsEditing ? "is-editing" : "")" data-scroll-target aria-labelledby="payment-form-title">
                <div class="form-card-header">
                    <h2 id="payment-form-title">
                        <i class="bi @(Model.IsEditing ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></i>
                        @(Model.IsEditing ? "Edit payment method" : "Add a payment method")
                    </h2>
                    @if (Model.IsEditing)
                    {
                        <span class="badge text-bg-warning">Editing</span>
                    }
                </div>
                <form method="post" asp-page="./Payments">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label asp-for="Input.RecipientName" class="form-label">Recipient or payee</label>
                            <input asp-for="Input.RecipientName" class="form-control" placeholder="e.g. Electric company, Landlord" autocomplete="off" required minlength="2" maxlength="100"
                                   data-autofocus="@(Model.IsEditing ? "true" : null)" />
                            <span asp-validation-for="Input.RecipientName" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Method" class="form-label">Payment method</label>
                            <select asp-for="Input.Method" class="form-select">
                                @foreach (var method in methods)
                                {
                                    <option value="@method" selected="@(Model.Input?.Method == method)">@method.Label()@(method == PaymentMethodType.PaymentApp ? " (PayPal, Venmo…)" : "")</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Method" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.UsualAmount" class="form-label">Usual amount <span class="optional">(optional)</span></label>
                            <input asp-for="Input.UsualAmount" class="form-control" placeholder="e.g. $50–100" autocomplete="off" maxlength="50" aria-describedby="amount-help" />
                            <span asp-validation-for="Input.UsualAmount" class="invalid-feedback d-block"></span>
                            <div id="amount-help" class="form-text">An approximate range is fine.</div>
                        </div>
                    </div>

                    <div class="form-actions mt-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="spinner-border spinner-border-sm btn-spinner" aria-hidden="true"></span>
                            <i class="bi @(Model.IsEditing ? "bi-check2" : "bi-plus-lg")" aria-hidden="true"></i>
                            @(Model.IsEditing ? "Save changes" : "Add payment method")
                        </button>
                        @if (Model.IsEditing)
                        {
                            <a asp-page="./Payments" class="btn btn-light">Cancel</a>
                        }
                    </div>
                </form>
            </section>

            <section class="item-section" aria-labelledby="payments-list-title">
                <div class="item-section-header">
                    <h2 id="payments-list-title">Your payment methods</h2>
                    <span class="count-pill">@Model.PaymentMethods.Count</span>
                </div>

                @if (Model.PaymentMethods.Any())
                {
                    <div class="item-grid">
                        @foreach (var payment in Model.PaymentMethods)
                        {
                            <article class="item-card @(Model.Input?.Id == payment.Id ? "is-selected" : "")">
                                <div class="item-card-top">
                                    <span class="avatar tone-amber" aria-hidden="true"><i class="bi @payment.Method.Icon()"></i></span>
                                    <div class="item-card-title">
                                        <h3>@payment.RecipientName</h3>
                                        <span class="badge rounded-pill method-badge">@payment.Method.Label()</span>
                                    </div>
                                </div>
                                <p class="item-meta">
                                    <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                    @(string.IsNullOrWhiteSpace(payment.UsualAmount) ? "No usual amount recorded" : $"Usually {payment.UsualAmount}")
                                </p>
                                <div class="item-card-footer">
                                    <small>
                                        Added @payment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                        @if (payment.UpdatedAt.HasValue)
                                        {
                                            <span class="dot-sep">·</span><text>Updated @payment.UpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</text>
                                        }
                                    </small>
                                    <div class="item-actions">
                                        <a asp-page="./Payments" asp-route-edit="@payment.Id" class="btn btn-icon" title="Edit @payment.RecipientName" aria-label="Edit @payment.RecipientName">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form method="post" asp-page="./Payments" asp-page-handler="Delete" asp-route-id="@payment.Id"
                                              data-confirm="Delete @payment.RecipientName?" hx-confirm="Delete the payment method for @payment.RecipientName?">
                                            <button type="submit" class="btn btn-icon btn-icon-danger" title="Delete @payment.RecipientName" aria-label="Delete @payment.RecipientName">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                        <h3>No payment methods yet</h3>
                        <p>Record how you usually pay a bill or a person so unusual requests stand out.</p>
                    </div>
                }
            </section>
        </div>

        <aside class="manage-aside" aria-label="About usual payment methods">
            <div class="info-card">
                <h2><i class="bi bi-info-circle" aria-hidden="true"></i> Why record this?</h2>
                <p>Knowing your normal habits helps you notice when someone asks you to pay in an unusual way, like gift cards for a tax bill.</p>
            </div>
            <div class="info-card">
                <h2><i class="bi bi-lightbulb" aria-hidden="true"></i> Tips</h2>
                <ul class="tip-list">
                    <li><strong>Regular bills:</strong> electricity by bank transfer, rent by check, phone by card.</li>
                    <li><strong>People you pay:</strong> who you normally send money to, and how.</li>
                    <li><strong>Spot changes:</strong> if you always pay rent by check, a text asking for gift cards is suspicious.</li>
                </ul>
            </div>
            <div class="info-card info-card-warning">
                <h2><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Red flags</h2>
                <p>Legitimate organizations rarely ask you to suddenly switch to gift cards, cryptocurrency or wire transfers.</p>
            </div>
        </aside>
    </div>
</div>
