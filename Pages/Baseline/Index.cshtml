@page
@model FraudVerificationDemo.Pages.Baseline.IndexModel
@using FraudVerificationDemo.Models
@{
    ViewData["Title"] = "My Personal Scam Protection Plan";
    ViewData["Description"] = "Review your personal scam protection plan, including safety rules, trusted contacts, and usual payment methods to help recognize unusual requests.";
    var hasAnyData = Model.ProtectionRulesCount > 0 || Model.TrustedContactsCount > 0 || Model.UsualPaymentMethodsCount > 0;
    var completed = (Model.ProtectionRulesCount > 0 ? 1 : 0) + (Model.TrustedContactsCount > 0 ? 1 : 0) + (Model.UsualPaymentMethodsCount > 0 ? 1 : 0);
    var percent = completed * 100 / 3;
}

<div class="manage-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Index">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">My protection plan</span>
    </nav>

    <header class="plan-hero">
        <div>
            <span class="eyebrow">Your personal protection plan</span>
            <h1>My protection plan</h1>
            <p>A few details you record while calm can help you notice when something is out of the ordinary.</p>
        </div>
        <div class="plan-progress" aria-label="Plan progress">
            <div class="plan-progress-label"><strong>@completed of 3</strong> sections set up</div>
            <div class="progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100" aria-label="Plan completion">
                <div class="progress-bar progress-@percent"></div>
            </div>
        </div>
    </header>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <a asp-page="./Rules" class="stat-card">
                <span class="stat-icon tone-teal" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                <span class="stat-number">@Model.ProtectionRulesCount</span>
                <span class="stat-title">Protection rules</span>
                <span class="stat-text">Personal boundaries for unusual requests.</span>
                <span class="stat-link">Manage rules <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="./Contacts" class="stat-card">
                <span class="stat-icon tone-blue" aria-hidden="true"><i class="bi bi-people"></i></span>
                <span class="stat-number">@Model.TrustedContactsCount</span>
                <span class="stat-title">Trusted contacts</span>
                <span class="stat-text">People you can call to verify a request.</span>
                <span class="stat-link">Manage contacts <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="./Payments" class="stat-card">
                <span class="stat-icon tone-amber" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                <span class="stat-number">@Model.UsualPaymentMethodsCount</span>
                <span class="stat-title">Usual payments</span>
                <span class="stat-text">How you normally pay bills and people.</span>
                <span class="stat-link">Manage payments <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
    </div>

    @if (!hasAnyData)
    {
        <section class="getting-started" aria-labelledby="start-title">
            <h2 id="start-title"><i class="bi bi-rocket-takeoff" aria-hidden="true"></i> Getting started</h2>
            <p>You haven’t set up your plan yet. Start with any of these:</p>
            <ol class="start-steps">
                <li><a asp-page="./Rules"><strong>Add a protection rule</strong><span>For example: “I will never pay taxes with gift cards.”</span></a></li>
                <li><a asp-page="./Contacts"><strong>Add a trusted contact</strong><span>Family or close friends who might genuinely ask for help.</span></a></li>
                <li><a asp-page="./Payments"><strong>Record a usual payment</strong><span>How you normally pay, so odd requests stand out.</span></a></li>
            </ol>
            <p class="small text-secondary mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> Demo mode: data is stored in this app’s local database.</p>
        </section>
    }
    else
    {
        <h2 class="section-title">Recently added</h2>
        <div class="row g-4">
            <div class="col-lg-4">
                <section class="recent-card">
                    <header><h3><i class="bi bi-shield-check" aria-hidden="true"></i> Rules</h3><a asp-page="./Rules">View all</a></header>
                    @if (Model.RecentRules.Any())
                    {
                        <ul>
                            @foreach (var rule in Model.RecentRules)
                            {
                                <li><span class="text-truncate-2">@rule.Content</span></li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="recent-empty">No rules yet. <a asp-page="./Rules">Add one</a></p>
                    }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="recent-card">
                    <header><h3><i class="bi bi-people" aria-hidden="true"></i> Contacts</h3><a asp-page="./Contacts">View all</a></header>
                    @if (Model.RecentContacts.Any())
                    {
                        <ul>
                            @foreach (var contact in Model.RecentContacts)
                            {
                                <li>
                                    <span><strong>@contact.Name</strong>@if (!string.IsNullOrEmpty(contact.Relationship)) {<small> · @contact.Relationship</small>}</span>
                                    <span class="font-monospace small text-secondary">@contact.Phone</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="recent-empty">No contacts yet. <a asp-page="./Contacts">Add one</a></p>
                    }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="recent-card">
                    <header><h3><i class="bi bi-wallet2" aria-hidden="true"></i> Payments</h3><a asp-page="./Payments">View all</a></header>
                    @if (Model.RecentPaymentMethods.Any())
                    {
                        <ul>
                            @foreach (var payment in Model.RecentPaymentMethods)
                            {
                                <li>
                                    <span><strong>@payment.RecipientName</strong></span>
                                    <span class="badge rounded-pill method-badge"><i class="bi @payment.Method.Icon()" aria-hidden="true"></i> @payment.Method.Label()</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="recent-empty">No payment methods yet. <a asp-page="./Payments">Add one</a></p>
                    }
                </section>
            </div>
        </div>

        <section class="tips-band" aria-labelledby="tips-title">
            <h2 id="tips-title"><i class="bi bi-lightbulb" aria-hidden="true"></i> Using your plan</h2>
            <ul>
                <li>When someone asks for money, check whether they match your trusted contacts.</li>
                <li>When asked to pay, compare the request with your usual payment methods.</li>
                <li>Review your rules regularly and add new ones as you learn.</li>
                <li>If something feels off, pause and verify.</li>
            </ul>
        </section>
    }
</div>
