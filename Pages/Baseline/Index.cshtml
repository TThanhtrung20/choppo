@page
@model FraudVerificationDemo.Pages.Baseline.IndexModel
@using FraudVerificationDemo.Models
@{
    ViewData["Title"] = "My Personal Scam Protection Plan";
    ViewData["Description"] = "Review your personal scam protection plan, including safety rules, trusted contacts, and usual payment methods to help recognize unusual requests.";
    var hasAnyData = Model.ProtectionRulesCount > 0 || Model.TrustedContactsCount > 0 || Model.UsualPaymentMethodsCount > 0;
}

<div class="manage-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb"><a asp-page="/Index">Home</a><span>/</span><span>My protection plan</span></nav>
    <header class="manage-heading"><div><span class="eyebrow">YOUR PERSONAL PROTECTION PLAN</span><h1>My protection plan</h1><p>A few details you record while calm can help you notice when something is out of the ordinary.</p></div></header>
    
    <div class="alert alert-info mb-4">
        <h5 class="alert-heading">📋 What is this?</h5>
        <p class="mb-0">
            Your protection baseline helps you recognize when something is unusual. 
            By recording your normal patterns (who you trust, how you usually pay), 
            you can spot when someone asks you to do something different.
        </p>
    </div>

    <div class="row g-4 mb-5">
        <!-- Protection Rules Card -->
        <div class="col-md-4">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title">
                        🛡️ Protection Rules
                    </h5>
                    <p class="display-4 text-primary mb-3">@Model.ProtectionRulesCount</p>
                    <p class="card-text text-muted">
                        Your usual phone numbers, email addresses, and physical addresses.
                    </p>
                    <a asp-page="./Rules" class="btn btn-primary w-100">
                        Manage Rules
                    </a>
                </div>
            </div>
        </div>

        <!-- Trusted Contacts Card -->
        <div class="col-md-4">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">
                        👥 Trusted Contacts
                    </h5>
                    <p class="display-4 text-success mb-3">@Model.TrustedContactsCount</p>
                    <p class="card-text text-muted">
                        People you trust who might ask you for help or money.
                    </p>
                    <a asp-page="./Contacts" class="btn btn-success w-100">
                        Manage Contacts
                    </a>
                </div>
            </div>
        </div>

        <!-- Usual Payment Methods Card -->
        <div class="col-md-4">
            <div class="card h-100 border-warning">
                <div class="card-body">
                    <h5 class="card-title">
                        💳 Usual Payment Methods
                    </h5>
                    <p class="display-4 text-warning mb-3">@Model.UsualPaymentMethodsCount</p>
                    <p class="card-text text-muted">
                        How you usually pay bills and make payments.
                    </p>
                    <a asp-page="./Payments" class="btn btn-warning w-100">
                        Manage Payments
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Getting Started -->
    @if (!hasAnyData)
    {
        <div class="card bg-light">
            <div class="card-body">
                <h4 class="card-title">🚀 Getting Started</h4>
                <p class="mb-3">You haven't set up your baseline yet. Here's what to add:</p>
                <ol>
                    <li class="mb-2">
                        <strong>Protection Rules:</strong> Personal safety principles like "I will never pay taxes with gift cards"
                    </li>
                    <li class="mb-2">
                        <strong>Trusted Contacts:</strong> Add family and close friends who might 
                        genuinely ask you for help or money.
                    </li>
                    <li class="mb-2">
                        <strong>Usual Payment Methods:</strong> Record how you usually pay bills 
                        to spot unusual payment requests.
                    </li>
                </ol>
                <p class="text-muted mb-0">
                    <small>
                        <strong>Note:</strong> This is demo mode - data is stored locally on this device only.
                    </small>
                </p>
            </div>
        </div>
    }
    
    <!-- Recent Activity -->
    @if (hasAnyData)
    {
        <div class="row g-4">
            <!-- Recent Rules -->
            @if (Model.RecentRules.Any())
            {
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">🛡️ Recent Protection Rules</h5>
                            <a asp-page="./Rules" class="btn btn-sm btn-light">View All</a>
                        </div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                @foreach (var rule in Model.RecentRules)
                                {
                                    <div class="list-group-item">
                                        <p class="mb-1">@rule.Content</p>
                                        <small class="text-muted">Added @(rule.CreatedAt.ToLocalTime().ToShortDateString())</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            <!-- Recent Contacts -->
            @if (Model.RecentContacts.Any())
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">👥 Recent Contacts</h5>
                            <a asp-page="./Contacts" class="btn btn-sm btn-light">View All</a>
                        </div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                @foreach (var contact in Model.RecentContacts)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@contact.Name</strong>
                                            @if (!string.IsNullOrEmpty(contact.Relationship))
                                            {
                                                <span class="text-muted"> - @contact.Relationship</span>
                                            }
                                            <br />
                                            <small class="text-muted">📞 @contact.Phone</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            <!-- Recent Payment Methods -->
            @if (Model.RecentPaymentMethods.Any())
            {
                <div class="col-md-6">
                    <div class="card">
                        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">💳 Recent Payment Methods</h5>
                            <a asp-page="./Payments" class="btn btn-sm btn-dark">View All</a>
                        </div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                @foreach (var payment in Model.RecentPaymentMethods)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@payment.RecipientName</strong>
                                            <br />
                                            <small class="text-muted">
                                                @switch (payment.Method)
                                                {
                                                    case PaymentMethodType.BankTransfer:
                                                        <span>🏦 Bank Transfer</span>
                                                        break;
                                                    case PaymentMethodType.CreditCard:
                                                        <span>💳 Credit Card</span>
                                                        break;
                                                    case PaymentMethodType.DebitCard:
                                                        <span>💳 Debit Card</span>
                                                        break;
                                                    case PaymentMethodType.PaymentApp:
                                                        <span>📱 Payment App</span>
                                                        break;
                                                    case PaymentMethodType.Check:
                                                        <span>✍️ Check</span>
                                                        break;
                                                    case PaymentMethodType.Other:
                                                        <span>Other</span>
                                                        break;
                                                }
                                                @if (!string.IsNullOrEmpty(payment.UsualAmount))
                                                {
                                                    <text> - @payment.UsualAmount</text>
                                                }
                                            </small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Quick Tips -->
        <div class="alert alert-info mt-4">
            <h5 class="alert-heading">💡 Using Your Baseline</h5>
            <ul class="mb-0">
                <li>When someone asks for money, check if they match your trusted contacts</li>
                <li>When asked to pay, compare to your usual payment methods</li>
                <li>Review your protection rules regularly - add new ones as you learn</li>
                <li>If something feels off, it probably is - pause and verify!</li>
            </ul>
        </div>
    }
</div>
