@page
@model FraudVerificationDemo.Pages.Baseline.ContactsModel
@{
    ViewData["Title"] = "Trusted Contacts for Scam Prevention";
    ViewData["Description"] = "Save trusted friends and family to help verify unusual requests for money and reduce the risk of impersonation scams.";
}

<div class="manage-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <a asp-page="/Index">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <a asp-page="./Index">My protection</a><i class="bi bi-chevron-right" aria-hidden="true"></i>
        <span aria-current="page">Trusted contacts</span>
    </nav>

    <header class="manage-heading">
        <div class="manage-heading-main">
            <span class="manage-icon tone-blue" aria-hidden="true"><i class="bi bi-people"></i></span>
            <div>
                <span class="eyebrow">Your personal protection plan</span>
                <h1>Trusted contacts</h1>
                <p>People you can contact to independently verify an unusual request.</p>
            </div>
        </div>
        <a asp-page="./Index" class="btn btn-outline-primary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Back to overview</a>
    </header>

    <div id="contacts-panel" class="manage-layout" hx-target="#contacts-panel" hx-select="#contacts-panel" hx-swap="outerHTML">
        <div class="manage-main">
            <partial name="Shared/Components/_StatusMessage" model="Model.StatusMessage" />

            <section class="form-card @(Model.IsEditing ? "is-editing" : "")" data-scroll-target aria-labelledby="contact-form-title">
                <div class="form-card-header">
                    <h2 id="contact-form-title">
                        <i class="bi @(Model.IsEditing ? "bi-pencil-square" : "bi-person-plus")" aria-hidden="true"></i>
                        @(Model.IsEditing ? "Edit contact" : "Add a trusted contact")
                    </h2>
                    @if (Model.IsEditing)
                    {
                        <span class="badge text-bg-warning">Editing</span>
                    }
                </div>
                <form method="post" asp-page="./Contacts">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.Name" class="form-label">Name</label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Mom, John Smith" autocomplete="off" required minlength="2" maxlength="100"
                                   data-autofocus="@(Model.IsEditing ? "true" : null)" />
                            <span asp-validation-for="Input.Name" class="invalid-feedback d-block"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Phone" class="form-label">Phone number</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone" aria-hidden="true"></i></span>
                                <input asp-for="Input.Phone" class="form-control" placeholder="555-0100" inputmode="tel" autocomplete="off" required pattern="555-[0-9]{4}" maxlength="20" aria-describedby="phone-help" />
                            </div>
                            <span asp-validation-for="Input.Phone" class="invalid-feedback d-block"></span>
                            <div id="phone-help" class="form-text">Demo format: 555-XXXX</div>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Relationship" class="form-label">Relationship <span class="optional">(optional)</span></label>
                            <input asp-for="Input.Relationship" class="form-control" placeholder="e.g. Mother, Brother, Friend" autocomplete="off" maxlength="50" />
                            <span asp-validation-for="Input.Relationship" class="invalid-feedback d-block"></span>
                        </div>
                    </div>

                    <div class="form-actions mt-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="spinner-border spinner-border-sm btn-spinner" aria-hidden="true"></span>
                            <i class="bi @(Model.IsEditing ? "bi-check2" : "bi-plus-lg")" aria-hidden="true"></i>
                            @(Model.IsEditing ? "Save changes" : "Add contact")
                        </button>
                        @if (Model.IsEditing)
                        {
                            <a asp-page="./Contacts" class="btn btn-light">Cancel</a>
                        }
                    </div>
                </form>
            </section>

            <section class="item-section" aria-labelledby="contacts-list-title">
                <div class="item-section-header">
                    <h2 id="contacts-list-title">Your contacts</h2>
                    <span class="count-pill">@Model.Contacts.Count</span>
                </div>

                @if (Model.Contacts.Any())
                {
                    <div class="item-grid">
                        @foreach (var contact in Model.Contacts)
                        {
                            <article class="item-card @(Model.Input?.Id == contact.Id ? "is-selected" : "")">
                                <div class="item-card-top">
                                    <span class="avatar tone-blue" aria-hidden="true">@contact.Name.Substring(0, 1).ToUpperInvariant()</span>
                                    <div class="item-card-title">
                                        <h3>@contact.Name</h3>
                                        @if (!string.IsNullOrEmpty(contact.Relationship))
                                        {
                                            <span class="badge rounded-pill text-bg-light">@contact.Relationship</span>
                                        }
                                    </div>
                                </div>
                                <p class="item-meta"><i class="bi bi-telephone" aria-hidden="true"></i> <span class="font-monospace">@contact.Phone</span></p>
                                <div class="item-card-footer">
                                    <small>
                                        Added @contact.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                        @if (contact.UpdatedAt.HasValue)
                                        {
                                            <span class="dot-sep">·</span><text>Updated @contact.UpdatedAt.Value.ToLocalTime().ToString("MMM d, yyyy")</text>
                                        }
                                    </small>
                                    <div class="item-actions">
                                        <a asp-page="./Contacts" asp-route-edit="@contact.Id" class="btn btn-icon" title="Edit @contact.Name" aria-label="Edit @contact.Name">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form method="post" asp-page="./Contacts" asp-page-handler="Delete" asp-route-id="@contact.Id"
                                              data-confirm="Delete @contact.Name?" hx-confirm="Delete @contact.Name from your trusted contacts?">
                                            <button type="submit" class="btn btn-icon btn-icon-danger" title="Delete @contact.Name" aria-label="Delete @contact.Name">
                                                <i class="bi bi-trash3" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span class="empty-icon" aria-hidden="true"><i class="bi bi-person-plus"></i></span>
                        <h3>No contacts yet</h3>
                        <p>Add someone you trust above so you know who to call when something feels off.</p>
                    </div>
                }
            </section>
        </div>

        <aside class="manage-aside" aria-label="About trusted contacts">
            <div class="info-card">
                <h2><i class="bi bi-info-circle" aria-hidden="true"></i> Why keep this list?</h2>
                <p>Family and close friends might genuinely ask for help. Having their saved details makes it easier to spot an imposter.</p>
            </div>
            <div class="info-card">
                <h2><i class="bi bi-lightbulb" aria-hidden="true"></i> Tips</h2>
                <ul class="tip-list">
                    <li><strong>Add close family:</strong> parents, siblings, partner, children.</li>
                    <li><strong>Add close friends:</strong> people you’ve known for years.</li>
                    <li><strong>Know their usual number:</strong> a call from a new number asking for money is a warning sign.</li>
                    <li><strong>Verify before acting:</strong> call back on the number saved here.</li>
                </ul>
            </div>
            <div class="info-card info-card-warning">
                <h2><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Demo note</h2>
                <p>Use fictional phone numbers in 555-XXXX format only.</p>
            </div>
        </aside>
    </div>
</div>
