@page
@model FraudVerificationDemo.Pages.Baseline.ContactsModel
@{
    ViewData["Title"] = "Trusted Contacts";
}

<partial name="Shared/Components/_DemoWarning" />

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>👥 Trusted Contacts</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">← Back to Dashboard</a>
    </div>

    <div class="alert alert-warning">
        <h5 class="alert-heading">⚠️ Page Under Construction</h5>
        <p class="mb-0">
            This page will allow you to manage trusted contacts (family and friends who might legitimately ask for money).
            It will be implemented in Day 8 of the development plan.
        </p>
    </div>

    <div class="mt-4">
        <h4>Coming Soon:</h4>
        <ul>
            <li>Add trusted contacts with name, relationship, phone, email</li>
            <li>Edit and delete contacts</li>
            <li>View list of all trusted contacts</li>
        </ul>
    </div>
</div>
