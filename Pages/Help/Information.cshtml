@page
@model FraudVerificationDemo.Pages.Help.InformationModel
@{
    ViewData["Title"] = Model.ScenarioTitle;
    ViewData["Description"] = "Learn how to protect passwords, one-time codes, bank and card details, and identity documents from suspicious requests. Verify requests independently before sharing information.";
}

<div class="help-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb"><a asp-page="/Index">Home</a><span>/</span><a asp-page="/Help/Select">Get help</a><span>/</span><span>Information request</span></nav>
    @if (!string.IsNullOrEmpty(Model.ScenarioType))
    {
        <a class="back-link" asp-page="/Help/Select">← Choose a different situation</a>
    }
    <header class="page-intro"><span class="eyebrow">PERSONAL INFORMATION SAFETY</span><h1>@Model.ScenarioTitle</h1><p>Keep passwords, one-time codes, and financial details private. If someone contacted you unexpectedly, pause and verify their identity through a channel you find yourself.</p></header>
    <partial name="Shared/Components/_SafetyReminder" />
    <partial name="Shared/Components/_ActionButtons" />
    <partial name="Shared/Components/_VerificationGuidance" />

    <section class="content-panel mt-4"><div class="content-panel-heading"><span class="eyebrow">SENSITIVE DETAILS</span><h2>What information are they asking you to share?</h2><p>You do not need to enter or disclose any of these details here. This list is only to help identify the request.</p></div>
        <div class="reflection-list" role="list"><div role="listitem">Password, PIN, or security answer</div><div role="listitem">Text message or email verification code</div><div role="listitem">Bank account, card number, or card security code</div><div role="listitem">Identity number or photo of an identity document</div><div role="listitem">Installing an app, sharing your screen, or remote device access</div></div>
        <div class="alert alert-warning mt-4" role="note"><strong>Never share a one-time code or password with someone who contacted you.</strong> A caller may claim they need it to stop fraud, but sharing a code can allow them to access your account.</div>
    </section>

    <section class="next-steps"><span class="eyebrow">PROTECT YOUR ACCOUNTS</span><h2>What to do next</h2><ol><li><strong>Do not share the information.</strong> Do not read codes aloud, click unexpected links, or install software at their request.</li><li><strong>End the conversation.</strong> Contact the company using the number on your card or a website you type yourself.</li><li><strong>Secure affected accounts.</strong> If you already shared a password or code, change the password through the official app or website and contact the provider.</li><li><strong>Ask for help.</strong> Tell someone you trust what happened, especially before changing account or payment settings.</li></ol><a asp-page="/Index" class="btn btn-outline-primary">Back to the home page</a></section>
</div>
