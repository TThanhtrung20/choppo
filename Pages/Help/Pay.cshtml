@page
@model FraudVerificationDemo.Pages.Help.PayModel
@{
    ViewData["Title"] = Model.ScenarioTitle;
}

@if (!string.IsNullOrEmpty(Model.ScenarioType))
{
    <div class="container my-3">
        <p class="text-muted">
            <a href="/Help/Select">← Change scenario</a>
        </p>
    </div>
}

<!-- Safety Reminder Component -->
<partial name="Shared/Components/_SafetyReminder" />

<!-- Action Buttons Component -->
<partial name="Shared/Components/_ActionButtons" />

<!-- Verification Guidance Component -->
<partial name="Shared/Components/_VerificationGuidance" />

<!-- Additional Context Questions (Optional) -->
<div class="card mt-4">
    <div class="card-header bg-light">
        <h4 class="mb-0">What are they saying? (Optional - helps you think)</h4>
    </div>
    <div class="card-body">
        <p class="text-muted">You don't have to answer these, but thinking through them can help:</p>
        
        <div class="mb-4">
            <p class="fw-bold">Why do they say you need to pay?</p>
            <div class="btn-group-vertical w-100" role="group">
                <button type="button" class="btn btn-outline-secondary text-start py-3">I owe money or have a bill to pay</button>
                <button type="button" class="btn btn-outline-secondary text-start py-3">There's a problem with my account</button>
                <button type="button" class="btn btn-outline-secondary text-start py-3">I'll get money or a prize</button>
                <button type="button" class="btn btn-outline-secondary text-start py-3">Someone I know needs help</button>
                <button type="button" class="btn btn-outline-secondary text-start py-3">I'm not sure / They won't explain clearly</button>
            </div>
        </div>

        <div class="alert alert-info">
            <strong>Remember:</strong> These questions are just to help you think. The most important thing is in the yellow box at the top of this page.
        </div>
    </div>
</div>

<!-- Next Steps -->
<div class="mt-5 pt-4 border-top">
    <h3>What to do next:</h3>
    <ol class="fs-5">
        <li class="mb-3"><strong>Do NOT pay right now</strong></li>
        <li class="mb-3"><strong>End the conversation</strong> (hang up, close the message, leave)</li>
        <li class="mb-3"><strong>Verify through a channel you already have</strong> (number on your card, saved contact, official website you type yourself)</li>
        <li class="mb-3"><strong>Talk to someone you trust</strong> before paying</li>
    </ol>
    
    <div class="text-center mt-4">
        <a asp-page="/Index" class="btn btn-outline-primary btn-lg">Back to Home</a>
    </div>
</div>
