@page
@model FraudVerificationDemo.Pages.Help.AfterIncidentModel
@inject FraudVerificationDemo.Services.SafetyContentService SafetyContent
@{
    ViewData["Title"] = "I already paid or gave information";
}

<!-- STOP Message - Highest Priority -->
<div class="alert alert-danger border-danger" style="border-width: 3px;">
    <h2 class="alert-heading">⛔ STOP</h2>
    <p class="fs-4 mb-0">@SafetyContent.GetStopActionMessage()</p>
</div>

<!-- Quick Action Buttons -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <button type="button" class="btn btn-danger btn-action w-100" onclick="alert('Stop communicating with them now. Block their number/email.')">
            Stop all contact with them
        </button>
    </div>
    <div class="col-md-6">
        <button type="button" class="btn btn-primary btn-action w-100" onclick="alert('Call someone you trust right now to help you.')">
            Contact someone I trust
        </button>
    </div>
</div>

<!-- What Happened Section -->
<div class="card mt-4">
    <div class="card-header bg-light">
        <h3 class="mb-0">What happened? (Choose what matches)</h3>
    </div>
    <div class="card-body">
        <p class="text-muted mb-4">This helps us show you the right steps:</p>
        
        <h5 class="mb-3">Did you pay money?</h5>
        <div class="d-grid gap-2 mb-4">
            <button type="button" class="btn btn-outline-primary text-start py-3" data-bs-toggle="collapse" data-bs-target="#paymentHelp">
                <strong>Yes, I paid money</strong> →
            </button>
            <button type="button" class="btn btn-outline-primary text-start py-3" data-bs-toggle="collapse" data-bs-target="#infoHelp">
                <strong>No, but I gave them information</strong> →
            </button>
            <button type="button" class="btn btn-outline-secondary text-start py-3" data-bs-toggle="collapse" data-bs-target="#bothHelp">
                <strong>Both - I paid AND gave information</strong> →
            </button>
        </div>

        <!-- Payment Help Section (Collapsible) -->
        <div class="collapse" id="paymentHelp">
            <div class="card card-body bg-light">
                <h5>How did you pay?</h5>
                <div class="list-group">
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpCard">
                        💳 Debit or Credit Card
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpTransfer">
                        🏦 Bank Transfer / Wire / Payment App
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpGiftCard">
                        🎁 Gift Card or Prepaid Card
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpCrypto">
                        ₿ Cryptocurrency
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpCash">
                        💵 Cash (by mail or delivery)
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpMoneyTransfer">
                        💸 Money Transfer Service (Western Union, MoneyGram, etc.)
                    </button>
                </div>
            </div>
        </div>

        <!-- Information Help Section (Collapsible) -->
        <div class="collapse" id="infoHelp">
            <div class="card card-body bg-light">
                <h5>What information did you give?</h5>
                <div class="list-group">
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpPassword">
                        🔑 Password or Security Answer
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpOTP">
                        📱 Verification Code or OTP
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpCardNumber">
                        💳 Card Number, CVV, or Bank Account Number
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpSSN">
                        🆔 Social Security Number or ID Documents
                    </button>
                    <button type="button" class="list-group-item list-group-item-action" data-bs-toggle="collapse" data-bs-target="#helpDeviceAccess">
                        📲 Installed App / Gave Device Access
                    </button>
                </div>
            </div>
        </div>

        <!-- Both Section -->
        <div class="collapse" id="bothHelp">
            <div class="alert alert-warning">
                <p class="mb-0"><strong>Do both sections below:</strong> Follow the steps for the payment method you used AND the information type you gave.</p>
            </div>
        </div>
    </div>
</div>

<!-- Guidance Sections (All Collapsed Initially) -->

<!-- Card Payment -->
<div class="collapse mt-3" id="helpCard">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">💳 You paid with a Debit or Credit Card</h4>
        </div>
        <div class="card-body">
            <div style="white-space: pre-line;">@SafetyContent.GetPostPaymentGuidance("card")</div>
