@page
@model FraudVerificationDemo.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create a personal protection plan";
    ViewData["Description"] = "Create a Safeline demo account to save trusted contacts, personal safety rules, and usual payment methods for recognizing unusual requests.";
}

<div class="account-page">
    <nav class="page-breadcrumb" aria-label="Breadcrumb"><a asp-page="/Index">Home</a><i class="bi bi-chevron-right" aria-hidden="true"></i><span>Create account</span></nav>
    <div class="account-layout">
        <aside class="account-aside"><span class="eyebrow">PREPARE BEFORE YOU NEED IT</span><h1>A little planning can help you feel more confident.</h1><p>Create a personal plan with the people you trust, your own safety rules, and the ways you normally pay.</p><ul class="account-benefits"><li>Remember who you can call to verify a request</li><li>Set personal boundaries around payments</li><li>Notice when a request doesn’t match your normal routine</li></ul></aside>
        <section class="account-card">
            <h2>Create your account</h2><p class="account-subtitle">Set up your Safeline demo protection plan.</p>
            <div class="alert alert-info mb-4"><strong>Demo mode:</strong> Use test information only. Do not enter a real password or sensitive personal details.</div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3"><label asp-for="Input.Email" class="form-label">Email address</label><input asp-for="Input.Email" class="form-control" autocomplete="username" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Input.Password" class="form-label">Create a password</label><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="text-danger"></span><small class="form-text text-muted">At least 6 characters in this demo.</small></div>
                <div class="mb-4"><label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
                <button type="submit" class="btn btn-primary w-100"><span class="spinner-border spinner-border-sm btn-spinner" aria-hidden="true"></span><i class="bi bi-person-plus" aria-hidden="true"></i> Create my protection plan</button>
            </form>
            <p class="account-switch">Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
            <p class="account-demo-note">This demonstration stores account data locally. It is not a production service.</p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
