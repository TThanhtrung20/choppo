@page
@model FraudVerificationDemo.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "You Have Logged Out";
    ViewData["Description"] = "You have been logged out of your Safeline demo account. Return to the home page or log in again.";
}

<section class="logout-page">
    <span class="logout-icon" aria-hidden="true">✓</span>
    <span class="eyebrow">ACCOUNT</span>
    <h1>You’re logged out</h1>
    <p>You have successfully logged out of your Safeline demo account.</p>
    <div class="logout-actions"><a asp-page="/Index" class="btn btn-primary">Go to the home page</a><a asp-page="./Login" class="btn btn-outline-primary">Log in again</a></div>
</section>
