@page
@model FraudVerificationDemo.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center">
                <h1 class="mb-4">@ViewData["Title"]</h1>
                <p class="lead mb-4">You have been logged out successfully.</p>
                
                <div class="d-grid gap-2 col-8 mx-auto">
                    <a asp-page="/Index" class="btn btn-primary btn-lg">Go to Home</a>
                    <a asp-page="./Login" class="btn btn-outline-secondary">Log in again</a>
                </div>
            </div>
        </div>
    </div>
</div>
