@page
@model ErrorModel
@{
    ViewData["Title"] = "Something Went Wrong";
    ViewData["Description"] = "The page could not be completed. Return to Safeline or try again in a moment.";
}

<section class="error-page">
    <span class="logout-icon error-icon" aria-hidden="true"><i class="bi bi-exclamation-diamond"></i></span><span class="error-code">OOPS</span>
    <h1>We couldn’t complete that request.</h1>
    <p>Please try again in a moment, or return to the home page to find the help you need.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">Reference ID: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-primary">Go to the home page</a>
</section>
